# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: API key for OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=""

# GROQ_API_KEY: API key for Groq (https://console.groq.com/keys).
GROQ_API_KEY=""

# CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET:
# Legacy read-only credentials used solely for one-way Cloudinary -> Daytona Volume migration.
# Configure these in the AI Studio Secrets panel (never expose API_SECRET on client).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: Custom MP4/WebM video URL for the Auth page side showcase
VITE_AUTH_VIDEO_URL=""

# DAYTONA_API_KEY: Server-side API key for Daytona Cloud Sandboxes & Persistent Volumes (https://app.daytona.io).
# Configure this in the AI Studio Secrets panel (never expose on client).
DAYTONA_API_KEY=""
# Optional regional Daytona v2 API URL override
DAYTONA_V2_API_URL=""
# Central Daytona Volume name for isolated per-user/per-project storage
DAYTONA_PROJECT_VOLUME_NAME="whiterchat-project-storage"
# Comma-separated admin emails allowed to manage storage diagnostics and migration jobs
ADMIN_EMAILS="shahedalmefleh850@gmail.com"

# VITE_LOG_LEVEL: Optional log level (trace, debug, info, warn, error)
VITE_LOG_LEVEL="info"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
